# Copy to .env and edit.

# Port pcbgit is published on (local and LAN setups; production uses 80/443).
PCBGIT_PORT=3000

# Optional for local and LAN use: pcbgit serves any address it is reached at
# (localhost, an IP, a hostname), and clone URLs follow the one you typed.
# Defaults to http://localhost:<PCBGIT_PORT>. Set it only behind a reverse proxy
# with HTTPS, to that public URL, e.g. https://pcb.example.com.
# PCBGIT_ORIGIN=http://localhost:3000

# Public server (deploy/docker-compose.prod.yml): your domain, no scheme.
# Its DNS A/AAAA record must point at the server before the first start.
PCBGIT_DOMAIN=pcb.example.com

# Created on first start when no administrator exists. Use a long random password.
PCBGIT_ADMIN_USER=admin
PCBGIT_ADMIN_PASSWORD=change-me-now
PCBGIT_ADMIN_EMAIL=admin@localhost

# Updates pull the image GitHub Actions built for the commit instead of building
# on the server (default: ghcr.io/<owner>/<repo> of a GitHub remote). "build"
# always builds here.
# PCBGIT_UPDATE_IMAGE=build
